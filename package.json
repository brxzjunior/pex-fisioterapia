{
  "name": "fisio-pro",
  "version": "1.0.0",
  "private": true,
  "description": "FisioPro - Sistema de Gestão e Portfólio para Fisioterapia (PEX ADS)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "verify": "npm run typecheck && npm run build",
    "test": "npm run verify",
    "report:docx": "python generate_fisiopro_report.py",
    "report:pdf": "node generate_pdf_report.cjs"
  },
  "keywords": [
    "fisioterapia",
    "gestao",
    "portfolio",
    "ads",
    "pex"
  ],
  "author": "Braz Gonçalo Batista da Gama Junior",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
